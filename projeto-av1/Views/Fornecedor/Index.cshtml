@model IEnumerable<Fornecedor>
@{
    ViewData["Title"] = "Fornecedores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Fornecedores</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo</a>
</div>

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-success">@TempData["Aviso"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Nada cadastrado ainda.</p>
}
else
{
    <table class="table table-hover align-middle">
        <tr>
            <th>@Html.DisplayNameFor(x => x.RazaoSocial)</th>
            <th>@Html.DisplayNameFor(x => x.Cnpj)</th>
            <th>@Html.DisplayNameFor(x => x.Email)</th>
            <th>@Html.DisplayNameFor(x => x.Telefone)</th>
            <th>@Html.DisplayNameFor(x => x.Cidade)</th>
            <th></th>
        </tr>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.RazaoSocial</td>
                <td>@c.Cnpj</td>
                <td>@c.Email</td>
                <td>@c.Telefone</td>
                <td>@c.Cidade</td>
                <td class="text-nowrap text-end">
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Tem certeza que quer excluir?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
