@model Cliente
@{
    ViewData["Title"] = Model.Nome;
}

<h2>@Model.Nome</h2>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(x => x.Nome)</dt>
    <dd class="col-sm-9">@Model.Nome</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(x => x.Email)</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(x => x.Telefone)</dt>
    <dd class="col-sm-9">@Model.Telefone</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(x => x.Endereco)</dt>
    <dd class="col-sm-9">@Model.Endereco</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(x => x.DataCadastro)</dt>
    <dd class="col-sm-9">@Model.DataCadastro.ToString("dd/MM/yyyy")</dd>
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
