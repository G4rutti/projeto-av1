@model IEnumerable<Produto>
@{
    ViewData["Title"] = "Produtos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="m-0">Produtos</h2>
    <a asp-action="Create" class="btn btn-primary">+ Novo</a>
</div>

@if (TempData["Aviso"] != null)
{
    <div class="alert alert-success">@TempData["Aviso"]</div>
}

@if (!Model.Any())
{
    <p class="text-muted">Nada cadastrado ainda.</p>
}
else
{
    <table class="table table-hover align-middle">
        <tr>
            <th>@Html.DisplayNameFor(x => x.Nome)</th>
            <th>@Html.DisplayNameFor(x => x.Descricao)</th>
            <th>@Html.DisplayNameFor(x => x.Preco)</th>
            <th>@Html.DisplayNameFor(x => x.Estoque)</th>
            <th>@Html.DisplayNameFor(x => x.Ativo)</th>
            <th></th>
        </tr>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nome</td>
                <td>@c.Descricao</td>
                <td>@c.Preco.ToString("N2")</td>
                <td>@c.Estoque</td>
                <td>@(c.Ativo ? "Sim" : "Não")</td>
                <td class="text-nowrap text-end">
                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline"
                          onsubmit="return confirm('Tem certeza que quer excluir?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                    </form>
                </td>
            </tr>
        }
    </table>
}
